# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.local
*.env

# OS files
.DS_Store
Thumbs.db

# IDE/editor files
.vscode/
.idea/

# Logs
*.log

# Large data files
data/raw/
data/interim/
data/processed/
household_power_consumption.txt
power_clean.parquet
*.xlsx

# Keep empty data folders if needed
!data/.gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Allow deployment model files
!models/
!models/best_power_model.pkl
!models/feature_cols.pkl

# Allow deployment report files
!reports/
!reports/model_results.csv
!reports/test_predictions.csv
!reports/deployment_sample.parquet

# Model files to ignore by default, except deployment models above
*.joblib
*.h5
*.keras

# Plots / generated outputs
reports/figures/
outputs/
artifacts/

# Streamlit secrets
.streamlit/secrets.toml

# Mac/Linux temp files
*.swp
*.swo

# Python packaging
build/
dist/
*.egg-info/

# Test/cache folders
.pytest_cache/
.mypy_cache/
.ruff_cache/