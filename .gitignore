# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.local
*.env

# OS files
.DS_Store
Thumbs.db

# IDE/editor files
.vscode/
.idea/

# Logs
*.log

# Large data files
data/raw/
data/interim/
data/processed/
*.csv
*.txt
*.parquet
*.xlsx

# Keep empty data folders if needed
!data/.gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model files
# Keep these ignored if your model files are large
*.pkl
*.joblib
*.h5
*.keras

# Plots / generated outputs
reports/figures/
outputs/
artifacts/

# Streamlit secrets
.streamlit/secrets.toml

# Mac/Linux temp files
*.swp
*.swo

# Python packaging
build/
dist/
*.egg-info/

# Test/cache folders
.pytest_cache/
.mypy_cache/
.ruff_cache/